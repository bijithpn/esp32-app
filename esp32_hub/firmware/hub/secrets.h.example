// Copy this file to secrets.h (it is git-ignored) and fill it in. The board uses these ONCE, on its first boot with no saved
// Wi-Fi, so it joins your network without any app setup. After that the app can change the Wi-Fi as usual.
#pragma once
#define WIFI_SSID "your-wifi-name"       // 2.4 GHz network
#define WIFI_PASS "your-wifi-password"
#define LATITUDE  "9.93"                 // default weather location (the app can change it)
#define LONGITUDE "76.27"
